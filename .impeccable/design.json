  "narrative": {
    "northStar": "The Printed Results Sheet",
    "overview": "The page is a single offset-printed sheet a sales leader could pin above a desk. The proof is the picture: campaign numerals set in a compressed heavy grotesk sit in ruled rows, and everything else is a table, a rail, or a list held by hairlines on a 12-column grid.",
    "keyCharacteristics": [
      "Rules, not boxes: structure is drawn with 1px and 4px ink lines, never cards.",
      "One heavy compressed display voice; everything else is a plain humanist grotesk.",
      "Coral (#f1502f) is the only signal color.",
      "Square corners everywhere; zero elevation.",
      "Motion is one grammar: hairlines that draw themselves in, with numerals counting up."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Coral is the only color. If a second hue is needed, the design is wrong.",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Coral Rule",
        "body": "Text on a coral field is always ink. White on coral fails contrast and is never used.",
        "section": "colors"
      },
      {
        "name": "The Figures Rule",
        "body": "Numerals are always tabular and lining, and always set in the display face.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Surfaces never lift, blur, or glow. State changes are color swaps or an outline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw structure with rules: 1px between rows, 4px opening each section.",
      "Do set every campaign figure in the display face with tabular lining numerals.",
      "Do keep coral as the only color and use ink for any text placed on it.",
      "Do keep corners square and surfaces flat.",
      "Do limit motion to hairlines drawing in and numerals counting up; show final states under reduced motion."
    ],
    "donts": [
      "Don't add a gradient, shadow, glass, blur or rounded card.",
      "Don't introduce a second hue or use coral for small text.",
      "Don't put a label above a heading; section labels live in the side column.",
      "Don't use white text on coral.",
      "Don't set display type above 6rem."
    ]
  }
